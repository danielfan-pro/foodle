<!DOCTYPE html>
<html>
<head>
  <title>Foodle</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= csrf_meta_tags %>
  <%= render 'application/favicon' %>
  <script src="https://kit.fontawesome.com/93f0a04255.js" crossorigin="anonymous"></script>
</head>
<body>
  
  <nav class="top-bar">

    <div class="left">
      <a href="/"><%= image_tag("foodle transparent.png", alt: "logo", :class => "logo-nav-bar") %></a>
      <%= link_to 'Restaurants', restaurants_path(reset: 1), :class => "button hollow" %>
      <%= link_to 'Recipes', recipes_path(reset: 1), :class => "button hollow" %>
    </div>

    <div>
      <% default_profile = '/Default-profile.png' %>

      <div class="top-bar-section">
        <ul class="right nav-right">
          <li class="theme-toggle-item">
            <span id="theme-toggle-slot" class="theme-toggle-slot"></span>
          </li>
          <%- if current_user && current_user[:profile_photo].nil? == false-%>
            <li><%= link_to 'Sign Out', destroy_user_session_path, method: :delete, :class => "button hollow"%></li>
            <li><a href='/u/<%= current_user.username %>'><img class="profile-icon" src='<%= current_user.profile_photo %>' /></a></li>
           <%- elsif current_user && current_user[:profile_photo].nil? -%>  
              <li><%= link_to 'Sign Out', destroy_user_session_path, method: :delete, :class => "button hollow"%></li>
              <li><a href='/u/<%= current_user.username %>'><img class="profile-icon" src='<%= default_profile %>' /></a></li>
          <%- else -%>
            <li><%= link_to 'Sign In', new_user_session_path, :class => "button hollow" %></li>
          <%- end -%>
        </ul>
      </div>

    </div>

  </nav>

  <%- flash.each do |key, value| -%>
    <div class="flash flash-<%= key %>">
      <%= value %>
    </div>
  <%- end -%>

  <%= yield %>

  <%= javascript_include_tag 'application' %>
  
  <%- if Rails.env.development? || Rails.env.test? -%> 
    <%= javascript_tag do %>
      window.railsEnv = '<%= Rails.env %>'
    <%- end -%>
  <%- end -%>
  <%= javascript_pack_tag 'application' %>

  <%= render "layouts/extra_footer" %>
</body>
</html>
